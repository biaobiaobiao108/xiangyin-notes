{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumen-notes",
  "main": "./dist/worker/index.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}

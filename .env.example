# 首次启动前必须设置自己的登录凭据
XIANGYING_USERNAME=
XIANGYING_PASSWORD=
# 用 `openssl rand -hex 32` 生成；用于快捷指令调用 /api/import
# 仅在启用快捷指令导入时取消注释并填写
# XIANGYING_API_TOKEN=
# 如需远程 MCP，另行生成令牌；不要与快捷指令 Token 共用
# 用 `openssl rand -hex 32` 生成；MCP 客户端地址使用 /mcp/<令牌>，建议通过 HTTPS 访问
# XIANGYING_MCP_TOKEN=请替换为独立随机令牌
# 本机运行时可自定义数据库路径；Docker 部署请保持注释，避免覆盖镜像内的 /data（数据卷）
# DATABASE_PATH=./data/xiangying-notes.sqlite
# ASSETS_PATH=./data/attachments
HOST=0.0.0.0
PORT=3000
# PUBLIC_URL=https://notes.example.com
# TRUST_PROXY=true
# TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
COOKIE_SECURE=false

{
  "name": "xiangying-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx wrangler dev",
    "dev:client": "bun build ./app/index.html --outdir ./dist/dev-client --target browser --format esm --splitting --watch",
    "build:client": "bun run scripts/build-client.ts",
    "build:worker": "bunx wrangler deploy --dry-run --outdir dist/worker",
    "build": "bun run build:client && bun run build:worker",
    "typecheck": "bun check",
    "test": "bun test",
    "cf:dev": "bunx wrangler dev",
    "cf:deploy": "bunx wrangler deploy",
    "cf:db:migrate:local": "bunx wrangler d1 migrations apply xiangying-notes --local",
    "cf:db:migrate:remote": "bunx wrangler d1 migrations apply xiangying-notes --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code-block": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.43.0",
    "marked": "^17.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "bun-types": "1.4.3",
    "wrangler": "4.149.0"
  }
}

{
  "name": "xiangying-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:client": "bun build ./app/index.html --outdir ./dist/client --target browser --format esm --splitting --watch",
    "build:client": "bun run scripts/build-client.ts",
    "build:server": "bun build ./server/index.ts ./server/migrate.ts --outdir ./dist/server --target bun --format esm --production --minify",
    "build": "bun run build:client && bun run build:server",
    "start": "bun dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "preview": "bun run start",
    "db:migrate": "bun run scripts/migrate.ts"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^7.0.2"
  }
}

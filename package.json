{
  "name": "xiangying-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "format": "bun fmt \"app/**/*.ts\" \"app/**/*.tsx\" \"server/**/*.ts\" \"shared/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json",
    "dev:client": "bun build ./app/index.html --outdir ./dist/dev-client --target browser --format esm --splitting --watch",
    "build:client": "bun run scripts/build-client.ts",
    "build:server": "bun build ./server/index.ts ./server/migrate.ts ./server/vacuum.ts ./scripts/check-schema-drift.ts --outdir ./dist/server --target bun --format esm --production --minify --entry-naming=\"[name].[ext]\"",
    "build": "bun run build:client && bun run build:server",
    "start": "bun dist/server/index.js",
    "typecheck": "bun check",
    "test": "bun test --check",
    "preview": "bun run scripts/preview.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:check": "bun run scripts/check-schema-drift.ts",
    "db:vacuum": "bun run scripts/vacuum.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-code-block": "^3.32.1",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-task-item": "^3.32.1",
    "@tiptap/extension-task-list": "^3.32.1",
    "@tiptap/markdown": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@tiptap/suggestion": "^3.32.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.64.0",
    "marked": "^17.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "1.4.4"
  }
}
